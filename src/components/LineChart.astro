---
interface Point {
  label: string;
  value: number;
  display?: string;
}

interface Props {
  points: Point[];
  logScale?: boolean;
  unit?: string;
}

const { points, logScale = false, unit = '' } = Astro.props;

const W = 640;
const H = 260;
const padL = 46;
const padR = 20;
const padT = 24;
const padB = 36;

const transform = (v: number) => (logScale ? Math.log10(v) : v);
const values = points.map((p) => transform(p.value));
const minV = Math.min(...values);
const maxV = Math.max(...values);
const span = maxV - minV || 1;

const xFor = (i: number) => padL + (i / (points.length - 1)) * (W - padL - padR);
const yFor = (v: number) => padT + (1 - (transform(v) - minV) / span) * (H - padT - padB);

const linePoints = points.map((p, i) => `${xFor(i)},${yFor(p.value)}`).join(' ');
const areaPoints = `${xFor(0)},${H - padB} ${linePoints} ${xFor(points.length - 1)},${H - padB}`;
---

<div class="line-chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Line chart">
    <line x1={padL} y1={H - padB} x2={W - padR} y2={H - padB} class="axis" />

    <polygon points={areaPoints} class="area" />
    <polyline points={linePoints} class="line" />

    {points.map((p, i) => (
      <g>
        <circle cx={xFor(i)} cy={yFor(p.value)} r="4" class="dot" />
        <text x={xFor(i)} y={yFor(p.value) - 12} class="value-label" text-anchor="middle">
          {p.display ?? `${p.value}${unit}`}
        </text>
        <text x={xFor(i)} y={H - padB + 20} class="x-label" text-anchor="middle">
          {p.label}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .line-chart {
    margin: 1.8em 0 2.2em;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.2rem 1rem 0.6rem;
  }

  svg { width: 100%; height: auto; overflow: visible; }

  .axis { stroke: var(--border-strong); stroke-width: 1; }

  .area {
    fill: var(--accent-dim);
    opacity: 0.7;
  }

  .line {
    fill: none;
    stroke: var(--accent-strong);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .dot {
    fill: var(--bg-raised);
    stroke: var(--accent-strong);
    stroke-width: 2.5;
  }

  .value-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    fill: var(--highlight);
  }

  .x-label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-tertiary);
  }
</style>
