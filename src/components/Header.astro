---
import { sections, glossary, companyMap } from '../data/sections';
import { withBase, stripBase } from '../utils/url';

const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';

function isActive(slug: string) {
  return currentPath === `/${slug}`;
}
---

<header class="site-header">
  <div class="bar container-wide">
    <a href={withBase('/')} class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      Data Centers &amp; GPUs <span class="brand-101">101</span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    <nav class="site-nav" id="site-nav">
      {sections.map((s) => (
        <a href={withBase(`/${s.slug}`)} class:list={['nav-link', { active: isActive(s.slug) }]}>
          <span class="nav-num">{s.number}</span>{s.navLabel}
        </a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      <a href={withBase(`/${glossary.slug}`)} class:list={['nav-link', { active: isActive(glossary.slug) }]}>
        {glossary.navLabel}
      </a>
      <a href={withBase(`/${companyMap.slug}`)} class:list={['nav-link', 'nav-link-highlight', { active: isActive(companyMap.slug) }]}>
        {companyMap.navLabel}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 12, 15, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover { color: var(--text-primary); text-decoration: none; }

  .brand-mark {
    width: 0.6rem;
    height: 0.6rem;
    background: var(--accent);
    border-radius: 2px;
    box-shadow: 0 0 10px 1px var(--accent-border);
    flex-shrink: 0;
  }

  .brand-101 { color: var(--highlight); }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .site-nav::-webkit-scrollbar { display: none; }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover { color: var(--text-primary); background: var(--bg-raised); text-decoration: none; }
  .nav-link.active { color: var(--accent-strong); }

  .nav-num { color: var(--text-tertiary); margin-right: 0.35em; }
  .nav-link.active .nav-num { color: var(--highlight); }

  .nav-link-highlight { color: var(--accent); border: 1px solid var(--accent-border); }

  .nav-divider {
    width: 1px;
    height: 1.2rem;
    background: var(--border-strong);
    margin: 0 0.4rem;
    flex-shrink: 0;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    padding: 0.4rem;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .nav-toggle { display: inline-flex; align-items: center; justify-content: center; }

    .site-nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      background: var(--bg-raised);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      align-items: stretch;
      padding: 0.5rem;
      gap: 0;
      display: none;
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
    }
    .site-nav.open { display: flex; }
    .nav-link { padding: 0.8rem 0.9rem; }
    .nav-divider { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
