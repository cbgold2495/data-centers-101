---
// Diagram 1: the 4-tier stack — applications → inference clouds → neoclouds/hyperscalers → GPU hardware & data centers.
---

<div class="diagram-wrap">
  <svg viewBox="0 0 700 430" role="img" aria-label="Diagram: applications sit on inference clouds, which sit on neoclouds and hyperscalers, which sit on GPU hardware and data centers">
    <!-- connectors -->
    <g class="connector">
      <line x1="350" y1="72" x2="350" y2="104" />
      <polygon points="343,104 357,104 350,114" />
    </g>

    <g class="connector">
      <line x1="350" y1="178" x2="350" y2="196" />
      <line x1="180" y1="196" x2="520" y2="196" />
      <line x1="180" y1="196" x2="180" y2="210" />
      <line x1="520" y1="196" x2="520" y2="210" />
      <polygon points="173,210 187,210 180,220" />
      <polygon points="513,210 527,210 520,220" />
    </g>

    <g class="connector">
      <line x1="180" y1="284" x2="180" y2="298" />
      <line x1="520" y1="284" x2="520" y2="298" />
      <line x1="180" y1="298" x2="520" y2="298" />
      <line x1="350" y1="298" x2="350" y2="312" />
      <polygon points="343,312 357,312 350,322" />
    </g>

    <!-- Layer 4: Applications -->
    <rect x="20" y="16" width="660" height="56" rx="10" class="box" />
    <text x="350" y="38" text-anchor="middle" class="layer-tag">LAYER 4</text>
    <text x="350" y="58" text-anchor="middle" class="box-title">Applications &amp; AI products</text>

    <!-- Layer 3: Inference clouds -->
    <rect x="20" y="104" width="660" height="74" rx="10" class="box" />
    <text x="350" y="130" text-anchor="middle" class="layer-tag">LAYER 3</text>
    <text x="350" y="150" text-anchor="middle" class="box-title">Inference clouds</text>
    <text x="350" y="168" text-anchor="middle" class="box-sub">Together, Fireworks, Groq, model-lab APIs</text>

    <!-- Layer 2: Neoclouds / Hyperscalers -->
    <rect x="20" y="210" width="320" height="74" rx="10" class="box" />
    <text x="180" y="236" text-anchor="middle" class="layer-tag">LAYER 2</text>
    <text x="180" y="256" text-anchor="middle" class="box-title">Neoclouds</text>
    <text x="180" y="274" text-anchor="middle" class="box-sub">CoreWeave, Lambda, Nebius, Crusoe</text>

    <rect x="360" y="210" width="320" height="74" rx="10" class="box" />
    <text x="520" y="236" text-anchor="middle" class="layer-tag">LAYER 2</text>
    <text x="520" y="256" text-anchor="middle" class="box-title">Hyperscalers</text>
    <text x="520" y="274" text-anchor="middle" class="box-sub">AWS, Azure, Google Cloud</text>

    <!-- Layer 1: GPU hardware & data centers -->
    <rect x="20" y="322" width="660" height="92" rx="10" class="box accent" />
    <text x="350" y="348" text-anchor="middle" class="layer-tag accent-tag">LAYER 1</text>
    <text x="350" y="368" text-anchor="middle" class="box-title">GPU hardware &amp; data centers</text>
    <text x="350" y="386" text-anchor="middle" class="box-sub">colocation / hyperscale / AI-specific halls,</text>
    <text x="350" y="401" text-anchor="middle" class="box-sub">NVIDIA chips, power, cooling, networking</text>
  </svg>
</div>

<style>
  .diagram-wrap {
    margin: 1.8em 0 2.2em;
  }
  svg { width: 100%; height: auto; }

  .box { fill: var(--bg-raised); stroke: var(--border); stroke-width: 1.5; }
  .box.accent { fill: var(--accent-dim); stroke: var(--accent-border); }

  .layer-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    fill: var(--highlight);
  }
  .layer-tag.accent-tag { fill: var(--highlight-strong); }

  .box-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    fill: var(--text-primary);
  }

  .box-sub {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--text-secondary);
  }

  .connector line {
    stroke: var(--border-strong);
    stroke-width: 2;
  }
  .connector polygon {
    fill: var(--border-strong);
  }
</style>
