---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A plain-English map of the AI infrastructure stack — data centers, GPUs, token economics, power, supply chain, and financing.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="description" content={description} />
    <title>{title} · Data Centers &amp; GPUs 101</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
